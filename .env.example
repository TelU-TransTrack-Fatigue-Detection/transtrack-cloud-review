# Callback
CALLBACK_URL=https://platform-integrator.transtrack.co/cloud-result
PUBLIC_BASE_URL=https://cloud.transtrack.co

# Storage TTL
RECORD_TTL_SECONDS=1800   # JSON records deleted after 30 min
VIDEO_TTL_SECONDS=2700    # processed videos deleted after 45 min

# HTTP timeouts
VIDEO_DOWNLOAD_TIMEOUT=60
HTTPX_TIMEOUT=30

# Model
MODEL_PATH=models/classifier/best_val_f1.pth
MODEL_NAME=MultiScaleTCN
MODEL_DOWNLOAD_URL=

# Queue
REDIS_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=2
MAX_QUEUE_SIZE=5000

# Batch inference (scripts/batch_video_infer.py)
# BATCH_WORKERS=4        # parallel worker processes (default: all CPU cores)
# BATCH_DEVICE=cpu       # cpu or cuda
# BATCH_TIMEOUT=60       # per-video download timeout in seconds
